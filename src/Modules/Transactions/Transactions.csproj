<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FastEndpoints"/>
        <PackageReference Include="FastEndpoints.Generator"/>
        <PackageReference Include="Mediator.Abstractions"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Same reasoning as Hosts/Promotions: the refund decision lives inside TransactionReversal,
             and a unit test that mocked an interface instead would assert nothing about the behaviour it
             is named for. No module references this project, so nothing outside Transactions can name
             the class; Bookings reaches it through Bookings.Contracts.IPaymentReversal. -->
        <InternalsVisibleTo Include="UnitTests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\SeedWork\SeedWork.csproj"/>
        <ProjectReference Include="..\..\Core\BuildingBlocks\BuildingBlocks.csproj"/>
        <ProjectReference Include="..\..\Infrastructure\Persistence\Persistence.csproj"/>
        <ProjectReference Include="..\Bookings\Bookings.Contracts\Bookings.Contracts.csproj"/>
    </ItemGroup>

</Project>
