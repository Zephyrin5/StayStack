<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
    </PropertyGroup>

    <ItemGroup>
        <!-- SeedWork is the cross-module shared kernel (Entity, enums like
             Currency, value objects) - safe for a Contracts project to
             depend on, unlike a reference to Catalog itself, which would
             reach into that module's own entities/DbContext. PropertyType/
             UnitType moved out of SeedWork into Catalog.Enums - neither is
             referenced by this project's own DTOs (UnitSummary,
             ConfirmedHold), so no dependency on Catalog.Enums is needed
             here either. -->
        <ProjectReference Include="..\..\..\Core\SeedWork\SeedWork.csproj"/>

        <!-- For AppException, which PromotionInvalidException derives from
             - PromotionInvalidException lives in this project specifically
             so Bookings can catch it (see its own doc comment), which means
             its base class needs to be reachable here too. BuildingBlocks
             is the same Core-tier, reference-free leaf project SeedWork is
             (no risk of a cycle back into Catalog), and Bookings already
             references it directly alongside Catalog.Contracts. -->
        <ProjectReference Include="..\..\..\Core\BuildingBlocks\BuildingBlocks.csproj"/>
    </ItemGroup>

</Project>
