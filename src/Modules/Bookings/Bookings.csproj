<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Bookings.Contracts is nested inside this project's folder;
             without this, SDK-default globbing would compile its files into
             both projects (the same CS0436 gotcha Catalog.csproj/Hosts.csproj
             already document for their own nested Contracts projects). -->
        <Compile Remove="Bookings.Contracts\**"/>
        <EmbeddedResource Remove="Bookings.Contracts\**"/>
        <None Remove="Bookings.Contracts\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FastEndpoints"/>
        <PackageReference Include="FastEndpoints.Generator"/>
        <PackageReference Include="Mediator.Abstractions"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
        <!-- For ReconcileOrphanedBookedHoldsJob - same TickerFunction source-
             generator Catalog/Identity already use for their own jobs. -->
        <PackageReference Include="TickerQ"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\SeedWork\SeedWork.csproj"/>
        <ProjectReference Include="..\..\Core\BuildingBlocks\BuildingBlocks.csproj"/>
        <ProjectReference Include="..\..\Infrastructure\Persistence\Persistence.csproj"/>
        <ProjectReference Include="..\Catalog\Catalog.Contracts\Catalog.Contracts.csproj"/>
        <ProjectReference Include="..\Hosts\Hosts.Contracts\Hosts.Contracts.csproj"/>
        <ProjectReference Include="..\Promotions\Promotions.Contracts\Promotions.Contracts.csproj"/>
        <ProjectReference Include="..\Transactions\Transactions.Contracts\Transactions.Contracts.csproj"/>
        <ProjectReference Include="Bookings.Contracts\Bookings.Contracts.csproj"/>
    </ItemGroup>

</Project>
