<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Promotions.Contracts is nested inside this project's folder;
             without this, SDK-default globbing would compile its files into
             both projects (the same CS0436 gotcha every other module's own
             nested Contracts project already documents). -->
        <Compile Remove="Promotions.Contracts\**"/>
        <EmbeddedResource Remove="Promotions.Contracts\**"/>
        <None Remove="Promotions.Contracts\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FastEndpoints"/>
        <PackageReference Include="FastEndpoints.Generator"/>
        <PackageReference Include="Mediator.Abstractions"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\SeedWork\SeedWork.csproj"/>
        <ProjectReference Include="..\..\Core\BuildingBlocks\BuildingBlocks.csproj"/>
        <ProjectReference Include="..\..\Infrastructure\Persistence\Persistence.csproj"/>
        <ProjectReference Include="..\Catalog\Catalog.Contracts\Catalog.Contracts.csproj"/>
        <ProjectReference Include="..\Hosts\Hosts.Contracts\Hosts.Contracts.csproj"/>
        <ProjectReference Include="Promotions.Contracts\Promotions.Contracts.csproj"/>
    </ItemGroup>

    <!-- Same reasoning as BuildingBlocks' own InternalsVisibleTo - lets
         PromotionRedemptionTests/PromotionRedemptionComputeDiscountAmountTests
         exercise ComputeDiscountAmount directly rather than only indirectly
         through a full RedeemAsync call. -->
    <ItemGroup>
        <InternalsVisibleTo Include="UnitTests"/>
    </ItemGroup>

</Project>
