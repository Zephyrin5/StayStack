<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Availability.Contracts is nested inside this project's folder;
             without this, SDK-default globbing would compile its files into
             both projects (the same CS0436 gotcha every other module's own
             nested Contracts project already documents). -->
        <Compile Remove="Availability.Contracts\**"/>
        <EmbeddedResource Remove="Availability.Contracts\**"/>
        <None Remove="Availability.Contracts\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FastEndpoints"/>
        <PackageReference Include="FastEndpoints.Generator"/>
        <PackageReference Include="Mediator.Abstractions"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
        <!-- For ExpiredHoldsSweepJob - same TickerFunction source-generator
             every other module with a job already uses. -->
        <PackageReference Include="TickerQ"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\SeedWork\SeedWork.csproj"/>
        <ProjectReference Include="..\..\Core\BuildingBlocks\BuildingBlocks.csproj"/>
        <ProjectReference Include="..\..\Infrastructure\Persistence\Persistence.csproj"/>
        <!-- For Catalog.Contracts.IUnitLookup.ResolveStayPricingAsync -
             HoldAvailabilityHandler needs a unit's price/capacity, but
             Availability owns no Unit/PricingRule data of its own. See
             docs/adr/0004's Availability-extraction note. -->
        <ProjectReference Include="..\Catalog\Catalog.Contracts\Catalog.Contracts.csproj"/>
        <ProjectReference Include="Availability.Contracts\Availability.Contracts.csproj"/>
    </ItemGroup>

</Project>
