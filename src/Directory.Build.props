<Project>
    <!-- The banned-API wiring every project shares. MSBuild imports only the nearest
         Directory.Build.props on its own, so the root one is named here. -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <ArtifactsPivots>$(MSBuildProjectName)</ArtifactsPivots>
        <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(MSBuildProjectName)\</BaseOutputPath>
        <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
        <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Dapper.AOT</InterceptorsPreviewNamespaces>
    </PropertyGroup>

    <!-- SS0001 and SS0002, the identity rules from docs/adr/0025, enforced by the compiler.
         The analyzer project cannot analyse itself, and Database's generated migrations are not
         hand-written code this applies to. -->
    <ItemGroup Condition="'$(MSBuildProjectName)' != 'StayStack.Analyzers'">
        <ProjectReference Include="$(MSBuildThisFileDirectory)Analyzers\StayStack.Analyzers\StayStack.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"
                          AdditionalProperties="PublishAot=false;PublishTrimmed=false" />
    </ItemGroup>
</Project>