<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- An analyzer is loaded into the compiler, which runs on netstandard2.0. It is the one
             project here that is not part of the application, so the AOT and framework settings the
             rest of src inherits do not apply to it. -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsAotCompatible>false</IsAotCompatible>
        <!-- CI builds the Api with PublishAot to run the trim analysers; that flows down every
             project reference, and this one cannot be AOT-published (NETSDK1207). -->
        <PublishAot>false</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md"/>
    </ItemGroup>

</Project>
